{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ApexLegendsTracker.WebAPI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/ApexLegendsTracker.WebAPI/bin/Debug/net10.0/ApexLegendsTracker.WebAPI.dll",
            "cwd": "${workspaceFolder}/ApexLegendsTracker.WebAPI",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5165"
            }
        }
    ]
}
